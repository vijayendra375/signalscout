# SignalScout environment configuration — copy to `.env` and edit locally.
# NEVER commit a real `.env` file or real secret values. This file contains
# placeholders only.

# --- Execution ---------------------------------------------------------------
SIGNALSCOUT_MAX_WORKERS=8
SIGNALSCOUT_CHECKPOINT_EVERY=25

# --- Network ----------------------------------------------------------------
SIGNALSCOUT_REQUEST_TIMEOUT=8.0
SIGNALSCOUT_MAX_RETRIES=3
SIGNALSCOUT_BACKOFF_FACTOR=1.5
SIGNALSCOUT_MAX_RESPONSE_BYTES=10485760
SIGNALSCOUT_USER_AGENT=SignalScout/1.0 (+https://builderr.ai/challenges/signalpost; research-bot)

# --- Budgets ----------------------------------------------------------------
SIGNALSCOUT_MAX_REQUESTS_PER_COMPANY=20
SIGNALSCOUT_MAX_PAGES_PER_WEBSITE=5
SIGNALSCOUT_DECLARED_COST_USD=0.0

# --- Storage ----------------------------------------------------------------
SIGNALSCOUT_DB_PATH=data/signalscout.db

# --- Optional language model (DISABLED by default; fixed at $0) -------------
# The deterministic pipeline needs none of these. Only set these to enable an
# explicitly-configured, OpenAI-compatible endpoint (e.g. a self-hosted NVIDIA
# NIM / vLLM server). SignalScout never auto-switches to a paid service.
SIGNALSCOUT_MODEL_PROVIDER=deterministic
SIGNALSCOUT_MODEL_NAME=
SIGNALSCOUT_MODEL_BASE_URL=
# Name of the environment variable that holds the API key (the key itself is
# never stored here and never logged).
SIGNALSCOUT_MODEL_API_KEY_ENV=SIGNALSCOUT_MODEL_API_KEY
# SIGNALSCOUT_MODEL_API_KEY=replace-with-your-own-key
